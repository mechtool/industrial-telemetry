# ========================================================
# Industrial Telemetry — Angular PWA + Nginx (Docker)
# ========================================================

# ---- Stage 1: Build Angular ----
FROM node:22-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

COPY . .
RUN npm run build

# ---- Stage 2: Nginx Runtime ----
FROM nginx:1.27-alpine

# Копируем собранный Angular
COPY --from=builder /app/dist/industrial-telemetry-client/browser /usr/share/nginx/html

# Nginx конфиг
COPY nginx/nginx.yc.conf /etc/nginx/conf.d/default.conf

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost/ || exit 1

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
