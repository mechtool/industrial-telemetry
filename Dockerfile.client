# ========================================================
# Industrial Telemetry — Angular PWA Client (browser-only)
# ========================================================

# ---- Stage 1: Build ----
FROM node:22-alpine AS builder

WORKDIR /build

COPY client/package*.json ./
RUN npm ci --legacy-peer-deps && npm cache clean --force

COPY client/angular.json ./
COPY client/tsconfig*.json ./
COPY client/ngsw-config.json ./
COPY client/src/ ./src/

RUN npx ng build --configuration production

# ---- Stage 2: Production Nginx ----
FROM nginx:alpine

COPY --from=builder /build/dist/browser /usr/share/nginx/html

# SPA fallback + API proxy to server:3000
RUN echo 'server { \
    listen 4000; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { try_files $uri $uri/ /index.html; } \
    location /api/ { \
        proxy_pass http://server:3000; \
        proxy_http_version 1.1; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -fsS http://localhost:4000/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
