# ========================================================
# Industrial Telemetry — Angular PWA Client (browser-only)
# ========================================================

# ---- Stage 1: Build ----
FROM node:22-alpine AS builder

WORKDIR /build

COPY client/package*.json ./
RUN npm ci && npm cache clean --force

COPY client/angular.json ./
COPY client/tsconfig*.json ./
COPY client/ngsw-config.json ./
COPY client/src/ ./src/

RUN npx ng build --configuration production

# ---- Stage 2: Production Nginx ----
FROM nginx:alpine

COPY --from=builder /build/dist/industrial-telemetry-client/browser /usr/share/nginx/html

# SPA fallback
RUN echo 'server { \
    listen 4000; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { try_files $uri $uri/ /index.html; } \
    location /api/ { return 502; } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:4000/ || exit 1

CMD ["nginx", "-g", "daemon off;"]