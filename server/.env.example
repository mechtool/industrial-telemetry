# ========================================================
# Industrial Telemetry — Express Server (шаблон локальной разработки)
#
# Скопировать:   cp server/.env.example server/.env
# Запуск:        cd server && npm run dev   (Express на http://localhost:3000)
#
# Файл gitignored — реальные значения в server/.env.
# Требует поднятого dev-окружения: docker compose up -d (из корня).
# ========================================================

PORT=3000
# false = не раздавать собранный клиент (клиент запускается отдельно на :4200).
# true  = раздавать ../client/dist/browser (нужно сначала собрать клиент: npm run build).
SERVE_CLIENT=false

# --------------- Ory Kratos / Keto (dev-контейнеры из docker-compose.yml) ---------------
KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_ADMIN_URL=http://localhost:4434
KETO_READ_URL=http://localhost:4466
KETO_WRITE_URL=http://localhost:4467

# --------------- MQTT (Mosquitto из dev-compose) ---------------
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=industrial/

# --------------- Webhook (Kratos -> server) ---------------
# Должно совпадать с web_hook.auth.config.value в kratos/kratos.docker.yml
# (по умолчанию в dev-конфиге: change-me-webhook-secret).
WEBHOOK_SECRET=change-me-webhook-secret

# --------------- Почта (письма подтверждения регистрации) ---------------
# По умолчанию письма идут в MailSlurper (dev-контейнер), смотреть: http://localhost:4436
SMTP_URL=smtps://localhost:1025
SMTP_REJECT_UNAUTHORIZED=false
MAIL_FROM=noreply@industrial-telemetry.ru
# Адрес, из которого строится ссылка подтверждения в письме.
APP_BASE_URL=http://localhost:3000

# --------------- DaData (подсказки адресов РФ) — необязательно ---------------
DADATA_API_KEY=
