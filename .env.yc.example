# ========================================================
# Industrial Telemetry — Yandex Cloud .env (шаблон)
#
# Скопировать:   cp .env.yc.example .env.yc
# Запуск:        docker compose -f docker-compose.yc.yml --env-file .env.yc up -d
#
# Секреты Kratos (cookie/cipher/SMTP) задаются в kratos/kratos.yc.yml
# (см. kratos/kratos.yc.example.yml), а НЕ в этом файле.
# ========================================================

# --------------- Публичный URL приложения ---------------
DOMAIN=industrial-telemetry.ru

# --------------- База данных (PostgreSQL) ---------------
DB_PASSWORD=change-me

# --------------- MQTT ---------------
MQTT_USERNAME=
MQTT_PASSWORD=

# --------------- Webhook (Kratos -> server) ---------------
# Общий секрет для /api/webhooks/registration.
# ДОЛЖЕН совпадать с `auth.config.value` в kratos/kratos.yc.yml (поле web_hook).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# и подставить одно и то же значение в оба места.
WEBHOOK_SECRET=
