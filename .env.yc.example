# ========================================================
# Industrial Telemetry — Yandex Cloud .env (шаблон)
#
# Скопировать:   cp .env.yc.example .env
# Запуск:         docker compose -f docker-compose.yc.yml up -d
# ========================================================

# --------------- Публичный URL приложения ---------------
# ВАЖНО: https — сертификат Let's Encrypt должен быть получен (см. DEPLOYMENT_GUIDE)
APP_URL=https://<ваш-домен>
CORS_ORIGIN=https://<ваш-домен>

# --------------- MQTT ---------------
# По умолчанию используется локальный mosquitto c авторизацией.
# Логин/пароль задаются через docker compose exec:
#   docker compose -f docker-compose.yc.yml exec mosquitto mosquitto_passwd -b /mosquitto/config/passwd server <пароль>
# Затем переменные ниже:
MQTT_USERNAME=server
MQTT_PASSWORD=

# Для Yandex IoT Core раскомментировать и указать:
# MQTT_BROKER_URL=mqtts://<registry-id>.mqtt.yandexcloud.net:8883
# MQTT_USERNAME=<device-id>
# MQTT_PASSWORD=<device-password>

# --------------- Опционально: Managed PostgreSQL ---------------
# Вместо контейнера postgres на VM можно использовать Managed Service for PostgreSQL.
# Для этого раскомментировать DSN в docker-compose.yc.yml в сервисе kratos-db,
# либо задать KRATOS_DSN здесь (требуется доработка compose-файла).