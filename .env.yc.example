# ========================================================
# Industrial Telemetry — .env.yc.example
# Шаблон переменных окружения для Yandex Cloud
# ========================================================

# ---- Ory Kratos (Managed PostgreSQL) ----
# DSN для Managed Service for PostgreSQL
# Формат: postgres://<user>:<password>@<fqdn>:6432/kratos?sslmode=require
KRATOS_DSN=postgres://kratos:your-password@rc1a-xxxx.mdb.yandexcloud.net:6432/kratos?sslmode=require

# ---- MQTT Broker ----
# Вариант A — Yandex IoT Core: mqtts://<registry-id>.mqtt.yandexcloud.net:8883
# Вариант B — Свой mosquitto на Compute Cloud: mqtt://<internal-ip>:1883
MQTT_BROKER_URL=mqtts://are-xxxxxxxxxxxx.mqtt.yandexcloud.net:8883
MQTT_CLIENT_ID=industrial-telemetry-server
MQTT_USERNAME=your-device-id
MQTT_PASSWORD=your-device-password
MQTT_TOPIC_PREFIX=industrial/

# ---- CORS (домен клиентского приложения) ----
CORS_ORIGIN=https://telemetry-frontend.website.yandexcloud.net

# ---- Сервер ----
NODE_ENV=production
PORT=3000
