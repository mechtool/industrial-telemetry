# ========================================================
# Industrial Telemetry — Yandex Cloud .env (шаблон)
#
# Скопировать:   cp .env.yc.example .env.yc
# Запуск:        docker compose -f docker-compose.yc.yml --env-file .env.yc up -d
#
# Секреты Kratos (cookie/cipher) задаются в kratos/kratos.yc.yml
# (см. kratos/kratos.yc.example.yml). SMTP-доступ задаётся здесь
# переменной SMTP_URI.
# ========================================================

# --------------- Публичный URL приложения ---------------
DOMAIN=industrial-telemetry.ru

# --------------- База данных (PostgreSQL) ---------------
DB_PASSWORD=change-me

# --------------- SMTP (письма recovery/verification) ---------------
# Формат: smtps://<user>:<пароль-приложения>@<smtp-хост>:465/?skip_ssl_verify=false
# Пример (Яндекс 360 для домена industrial-telemetry.ru):
#   smtps://noreply%40industrial-telemetry.ru:APP_PASSWORD@smtp.yandex.ru:465/?skip_ssl_verify=false
SMTP_URI=

# --------------- MQTT ---------------
MQTT_USERNAME=
MQTT_PASSWORD=

# --------------- Webhook (Kratos -> server) ---------------
# Общий секрет для /api/webhooks/registration.
# ДОЛЖЕН совпадать с `auth.config.value` в kratos/kratos.yc.yml (поле web_hook).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# и подставить одно и то же значение в оба места.
WEBHOOK_SECRET=
