# ========================================================
# Industrial Telemetry — Yandex Cloud .env (шаблон)
#
# Скопировать:   cp .env.yc.example .env.yc
# Запуск:        docker compose -f docker-compose.yc.yml --env-file .env.yc up -d
#
# Секреты Kratos (cookie/cipher) задаются в kratos/kratos.yc.yml
# (см. kratos/kratos.yc.example.yml). Здесь задаются два SMTP-канала:
#   SMTP_URI — Kratos (письма восстановления пароля);
#   SMTP_URL — сервер (письма подтверждения регистрации).
# ========================================================

# --------------- Публичный URL приложения ---------------
DOMAIN=industrial-telemetry.ru

# --------------- База данных (PostgreSQL) ---------------
DB_PASSWORD=change-me

# --------------- SMTP для Kratos (письма recovery/verification) ---------------
# Формат: smtps://<user>:<url-encoded-password>@<smtp-host>:465/?skip_ssl_verify=false
# Пароль обязательно URL-кодировать: символы + / = ломают URI.
#
# Вариант 1 — Yandex Cloud Postbox (первые 2000 писем в месяц бесплатно):
#   smtps://<ID_API_КЛЮЧА>:<СЕКРЕТ>@postbox.cloud.yandex.net:465/?skip_ssl_verify=false
#   Нужно: сервисный аккаунт с ролью postbox.sender, API-ключ со scope yc.postbox.send,
#   созданный адрес для домена, DKIM (2 CNAME) и SPF в DNS, подтверждение домена.
#
# Вариант 2 — Яндекс 360 для домена:
#   smtps://noreply%40industrial-telemetry.ru:APP_PASSWORD@smtp.yandex.ru:465/?skip_ssl_verify=false
#
# Пусто = Kratos стартует без почты, письма не уходят (в логах будет предупреждение).
SMTP_URI=

# --------------- Почта сервера (письма подтверждения регистрации) ---------------
# nodemailer в it-server. Обычно тот же провайдер, что и SMTP_URI, но без ?skip_ssl_verify.
# Пусто = smtps://localhost:1025 (MailSlurper) — в проде письма не уйдут.
SMTP_URL=
# Проверять TLS-сертификат SMTP-сервера. Для реальных провайдеров — true.
SMTP_REJECT_UNAUTHORIZED=true
# Отправитель: должен принадлежать домену, подтверждённому у провайдера.
MAIL_FROM=noreply@industrial-telemetry.ru
# Внешний адрес приложения: из него строится ссылка подтверждения в письме.
APP_BASE_URL=https://industrial-telemetry.ru

# --------------- MQTT ---------------
MQTT_USERNAME=
MQTT_PASSWORD=

# --------------- Webhook (Kratos -> server) ---------------
# Общий секрет для /api/webhooks/registration.
# ДОЛЖЕН совпадать с `auth.config.value` в kratos/kratos.yc.yml (поле web_hook).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# и подставить одно и то же значение в оба места.
WEBHOOK_SECRET=

# --------------- DaData (подсказки адресов РФ) ---------------
# Ключ API DaData для /api/address/suggest. Необязательно: без него подсказки
# адресов не работают, остальной функционал не страдает.
DADATA_API_KEY=
