# ========================================================
# Industrial Telemetry — Yandex Cloud .env (шаблон)
#
# Скопировать:   cp .env.yc.example .env.yc
# Запуск:        docker compose -f docker-compose.yc.yml --env-file .env.yc up -d
# ========================================================

# --------------- Публичный URL приложения ---------------
DOMAIN=industrial-telemetry.ru
APP_URL=https://<домен>
CORS_ORIGIN=https://<домен>

# --------------- База данных (PostgreSQL) ---------------
DB_PASSWORD=change-me

# --------------- Секреты Kratos ---------------
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KRATOS_COOKIE_SECRET=change-me-cookie-secret-64-hex
KRATOS_CIPHER_SECRET=change-me-cipher-secret-64-hex

# --------------- SMTP (пароль приложения Яндекса) ---------------
SMTP_URI=smtps://user%40yandex.ru:APP_PASSWORD@smtp.yandex.ru:465/?skip_ssl_verify=false

# --------------- MQTT ---------------
MQTT_USERNAME=
MQTT_PASSWORD=
