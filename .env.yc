# --------------- Публичный URL приложения ---------------
APP_URL=http://industrial-telemetry.ru
CORS_ORIGIN=http://industrial-telemetry.ru

# --------------- MQTT (локальный mosquitto на VM) ---------------
MQTT_USERNAME=
MQTT_PASSWORD=