# ========================================================
# Industrial Telemetry — Express API Server
# ========================================================
FROM node:22-alpine AS builder

WORKDIR /build

# Copy server files preserving directory structure for tsconfig rootDir
COPY server/package*.json ./server/
COPY server/tsconfig.json ./server/
COPY server/src/ ./server/src/

WORKDIR /build/server
RUN npm ci && npm cache clean --force

RUN npx tsc --project tsconfig.json

RUN npm prune --production

# ========================================================
# Production image
# ========================================================
FROM node:22-alpine
RUN addgroup -S app && adduser -S app -G app

WORKDIR /app

COPY --from=builder /build/server/node_modules ./node_modules
COPY --from=builder /build/server/dist ./dist
COPY server/.env ./

USER app
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:3000/api/health || exit 1

ENV NODE_ENV=production
CMD ["node", "dist/server/src/index.js"]